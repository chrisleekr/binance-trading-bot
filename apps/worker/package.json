{
  "name": "@app/worker",
  "version": "1.0.0",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "dev": "ROLE=worker bun --watch src/index.ts",
    "dev:study": "ROLE=study WORKER_ADMIN_PORT=9102 bun --watch src/index.ts",
    "build": "tsc -b",
    "typecheck": "tsc -b --noEmit && tsc -p tsconfig.test-d.json --noEmit",
    "test": "vitest run --exclude '**/integration/**'",
    "test:integration": "vitest run __tests__/integration --no-file-parallelism --hookTimeout=180000",
    "test:frame-replay": "vitest run __tests__/tick/frame-replay.test.ts",
    "test:frame-replay:generate": "vitest run __tests__/tick/frame-replay.generate.test.ts"
  },
  "dependencies": {
    "@app/binance": "workspace:*",
    "@app/contracts": "workspace:*",
    "@app/core": "workspace:*",
    "@app/db": "workspace:*",
    "@app/discovery": "workspace:*",
    "@app/indicators": "workspace:*",
    "@app/llm": "workspace:*",
    "@app/money": "workspace:*",
    "@app/notify": "workspace:*",
    "@app/strategy-backtest": "workspace:*",
    "@app/strategy-core": "workspace:*",
    "@app/strategy-registry": "workspace:*",
    "@app/strategy-trailing-trade": "workspace:*",
    "bullmq": "5.58.6",
    "ioredis": "~5.11.1",
    "pg": "~8.13.0",
    "pino": "~9.5.0",
    "ws": "~8.21.1",
    "zod": "~4.4.3",
    "@app/observability": "workspace:*"
  },
  "devDependencies": {
    "@app/testcontainers": "workspace:*",
    "@types/pg": "~8.11.0",
    "@types/ws": "~8.5.0",
    "nock": "~14.0.0"
  }
}
