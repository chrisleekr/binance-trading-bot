# Single source of truth for environment variables.
#
# Workflows:
#   - Host dev (`bun run dev`):   `bun run setup` copies this to .env; Bun auto-loads.
#   - Docker compose:             `cp .env.example .env`, then
#                                 `docker compose -f deploy/compose/docker-compose.yml --env-file .env up`.
#
# Production secrets (postgres_password, redis_password, session_secret) live
# under deploy/secrets/<name> and are NEVER read from this file.

# --- Runtime ---
NODE_ENV=development
LOG_LEVEL=info

# --- Public URLs ---
# WEB_ORIGIN is the allowlist of origins the SPA is served from — a
# comma-separated list (each entry an exact scheme://host:port). It gates CORS,
# Better Auth CSRF, and the WebSocket upgrade. Add a LAN address to reach the dev
# server from another device (the Vite dev server already binds all interfaces);
# a `*` wildcard is NOT supported because credentialed requests forbid it.
# Better Auth's `Secure` cookie has a localhost exemption per the browser spec,
# so plain http://localhost works for local dev; production hosts behind a TLS edge.
# Example (localhost + a LAN IP): WEB_ORIGIN=http://localhost:5173,http://192.168.1.50:5173
WEB_ORIGIN=http://localhost:5173
# PUBLIC_WEB_URL is the single public base URL the worker uses to build
# tap-through links in operator notifications (a finished backtest, an orphan
# order). Optional: leave it unset and notifications still send, just without
# the link. Reachable only where your phone can reach the app (LAN/VPN). No
# trailing slash.
# PUBLIC_WEB_URL=http://localhost:5173

# --- Sessions ---
# Min 32 chars (Zod-enforced). Generate with `openssl rand -hex 32`.
# Production uses the docker-compose.prod.yml `_FILE` secret instead.
# Placeholder is intentionally short so an unedited copy fails at boot
# rather than booting with a known-public secret.
AUTH_SECRET=REPLACE_ME

# --- Live demo (public, no-login, testnet-only deployment) ---
# LIVE_DEMO turns this box into a public sandbox: no login (the sole operator is injected for every request); credential, notifier, backup/restore, account-creation, account-rename/delete, retention-change, diagnosis-start, fee-reconciliation, and archive-backfill routes return 403; and the worker suppresses all notifier dispatch. Trading remains interactive on Binance testnet. Boot REFUSES to start if any account is live. Leave it off on your real instance.
# Parsed strictly: only '1' or 'true' enable it — 'false'/'0'/unset stay off.
# Read by BOTH the api and the worker. See docs/architecture/auth.md and the
# deploy/compose/docker-compose.demo.yml override.
LIVE_DEMO=0

# --- API HTTP server ---
PORT=3000
ADMIN_PORT=9100
# Interface the admin server binds. Default 127.0.0.1 keeps the unauthenticated
# /healthz, /readyz, /metrics off the LAN under compose. k8s sets 0.0.0.0 so the
# kubelet's httpGet probes reach the pod IP; restrict the port with a NetworkPolicy.
ADMIN_HOST=127.0.0.1

# AI assist (the backtest advisor) is configured in the app, not here: open
# Account → AI assistant to pick a provider (Anthropic or an OpenAI-compatible
# endpoint like Ollama) and enter its key/model. Settings are stored in the DB.

# --- Worker admin server ---
# Bound to 127.0.0.1 for /healthz, /readyz, /metrics. Must differ from
# ADMIN_PORT above when api + worker run on the same host (`bun run dev`);
# inside compose each container has its own loopback so a shared port
# would also work, but keeping them distinct avoids surprise. `bun run dev`
# starts a second `study` worker that pins its own admin port to 9102.
WORKER_ADMIN_PORT=9101
# Interface the admin server binds. Default 127.0.0.1 keeps the unauthenticated
# endpoints off the LAN under compose. k8s sets 0.0.0.0 so the kubelet's httpGet
# probes reach the pod IP; restrict the port with a NetworkPolicy.
WORKER_ADMIN_HOST=127.0.0.1

# Which listeners/consumers this process runs — one knob across api + worker:
#   all    (default) — api + live worker + study in one process (single box)
#   api    — api listeners only (also serves the built SPA)
#   worker — live trading consumers (crons, lifecycles, tick + pipeline)
#   study  — backtest + advisor consumers only
# Heavy backtests are CPU-bound; under `all` the study replay is throttled
# (STUDY_CPU_SHARE below) so it never starves the live tick or the api. `bun run
# dev` launches worker(ROLE=worker) + worker(ROLE=study) automatically; compose
# runs one ROLE=all `app` by default and splits into api/worker/study via
# docker-compose.scale.yml. This default applies to a bare `bun src/index.ts`.
ROLE=all

# Fraction of one CPU core a backtest replay may use, in (0, 1]. Under ROLE=all
# the study consumer shares the event loop with api + live trading, so the runner
# sleeps proportionally at its yield points to hold this share. Unset resolves to
# 0.5 under ROLE=all and 1.0 (full speed) for a dedicated worker/study process.
# STUDY_CPU_SHARE=0.5

# Max concurrent backtest replays (CPU-bound). On a shared-core dev box running
# a live worker + a study worker together, lower this to 1-2 so the OS keeps
# scheduling headroom for the live process. Prod's dedicated study box keeps 4.
BACKTEST_CONCURRENCY=4

# Per-tick budget (ms) for the durable symbol_states write. On timeout the tick
# falls back to the degraded cache-refresh path (read-your-writes stays intact).
# 100ms suits local SSD. Raise it on network-replicated block storage (e.g.
# Longhorn), where a commit fsync is a cross-node round-trip and 100ms makes the
# degraded path the steady state instead of a rare fallback.
# TICK_PERSIST_TIMEOUT_MS=100

# Max concurrent tick jobs on the `tick` queue. Under ROLE=all the tick loop
# shares the event loop with the api, so many concurrent ticks tail-latency the
# dashboard. Per-key ordering (chainByKey + jobId coalescing) holds regardless,
# so lowering this only trades throughput of distinct (profile, symbol) keys,
# never correctness. Default 25.
# TICK_CONCURRENCY=25

# Max concurrent Binance kline fetches per interval in the technicals-compute
# cron; each fetched symbol then runs ~7.6ms of synchronous indicator math. Under
# ROLE=all several stacked bursts monopolize the shared event loop, so lowering
# this bounds how many stack before a yield. Default 8.
# KLINE_CONCURRENCY=8

# --- Postgres / Redis ---
# Defaults below target host dev (`bun run dev`).
# For docker compose, replace `localhost` with the in-network DNS names
# `postgres` / `redis`, OR delete these lines to fall back to the compose
# file's built-in `${VAR:-...}` defaults (which already use the DNS names).
DATABASE_URL=postgres://postgres:postgres@localhost:55432/binance_trading_bot
REDIS_URL=redis://localhost:56379
# Used only by the postgres compose service to initialize the cluster.
POSTGRES_DB=binance_trading_bot
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# --- Worker tuning ---
# Action-log and audit-log retention are NOT env vars. They live in the
# `retention_config` table and are edited from Settings -> Retention, because a
# second owner for the same horizon is how the table came to be swept days
# earlier than the dashboard reported.
# Discovery universe-snapshot retention. The discovery cron logs a point-in-time
# universe row each cycle for a later net-edge backtest; keep a generous window
# so the dataset accumulates. Default 180 days.
DISCOVERY_SNAPSHOT_RETENTION_DAYS=180

# Per-profile net-P/L snapshot retention. The equity-snapshot cron records one
# point every 15 min (~96 rows/profile/day) for the profit-vs-hold chart; keep a
# long window. Default 365 days.
EQUITY_SNAPSHOT_RETENTION_DAYS=365

# --- Postgres SSL ---
# Read by libpq via subprocess env in apps/api/src/routes/backup.ts when
# running pg_dump / pg_restore; the node-postgres driver in @app/db
# ignores PGSSLMODE entirely (it uses its own `ssl: {...}` config).
# `disable` skips the TLS probe, which is what a known-plaintext local
# Postgres wants. `prefer` (libpq's own default) probes for TLS and falls
# back to plaintext. Tighten to `require` or `verify-full` against a
# TLS-fronted Postgres.
PGSSLMODE=disable

# --- Observability (OTel exporter wiring) ---
# Empty endpoint disables the exporter.
OTEL_SERVICE_NAME=binance-trading-bot
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=

# --- Web SPA build-time (Vite stamps into bundle at build, NOT runtime) ---
# Set before `bun run build` / `compose build`; changing after build has no effect.
VITE_API_BASE_URL=/api
VITE_PWA=0

# --- Production image pinning (override before `docker compose pull`) ---
# One image for the whole app (ROLE selects behaviour), published to
# chrisleekr/binance-trading-bot as `v<version>`. `latest` moves with each
# release-please release on `main`.
IMAGE_TAG=latest
# Host port the api ingress (api + SPA, same-origin) publishes on. Prod default 80.
APP_HTTP_PORT=80
# Live-worker replica count. Keep at 1: multi-replica is not yet enabled (the
# epic #561 scale-out plumbing is merged but the propagation seams stay dormant
# at one replica). Positive integer only; 0 or a non-integer aborts startup.
WORKER_REPLICAS=1

# --- Backup ---
# Directory the worker's db-backup cron writes `backup-<epochms>.dump` files to,
# and the dir GET /backup/config lists. Bind-mounted to ./backups by compose for
# both the api and worker. The backup SCHEDULE (enable, interval hours, retention
# count) is configured in-app under Account → Backup, NOT via env.
BACKUP_DIR=/backups
