{
  "name": "binance-trading-bot",
  "private": true,
  "version": "1.0.0",
  "license": "Apache-2.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "e2e",
    "packages/*",
    "packages/strategy/*"
  ],
  "packageManager": "bun@1.3.12",
  "engines": {
    "bun": ">=1.3"
  },
  "scripts": {
    "dev": "turbo run dev dev:study",
    "dev:infra": "docker compose -f deploy/compose/docker-compose.yml -f deploy/compose/docker-compose.local.yml -f deploy/compose/docker-compose.infra.yml up -d --build --no-deps postgres redis",
    "docker:dev": "docker compose -f deploy/compose/docker-compose.yml -f deploy/compose/docker-compose.local.yml up --build",
    "build": "turbo build",
    "lint": "bash scripts/ci/lint.sh",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "test:replay": "bun --filter @app/strategy-trailing-trade test:replay && bun --filter @app/strategy-momentum test:replay",
    "bench:strategy": "turbo bench",
    "test:e2e": "turbo test:e2e",
    "db:generate": "bun --filter @app/db generate",
    "db:migrate": "bun --filter @app/db migrate",
    "db:check": "bun --filter @app/db check",
    "compose:build": "docker compose -f deploy/compose/docker-compose.yml build",
    "setup": "bun ./scripts/setup.ts",
    "seed:dev": "bun ./scripts/seed-dev-data.ts",
    "docs:screenshots": "bun ./scripts/docs/screenshots.ts",
    "docs:gen": "bun scripts/docs/gen-config-tables.ts",
    "docs:install": "uv sync --group docs",
    "docs:serve": "uv run mkdocs serve",
    "docs:build": "bun run docs:gen --check && uv run mkdocs build --strict",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "~19.6.0",
    "@commitlint/config-conventional": "~19.6.0",
    "@types/bun": "~1.3.0",
    "@vitest/coverage-v8": "~4.0.0",
    "branch-name-lint": "~3.0.0",
    "husky": "~9.1.0",
    "lint-staged": "~15.4.0",
    "oxlint": "1.76.0",
    "prettier": "~3.8.0",
    "prettier-plugin-tailwindcss": "~0.8.1",
    "turbo": "^2.9.16",
    "typescript": "~6.0.0",
    "vitest": "~4.0.0"
  },
  "dependencies": {
    "@app/api": "workspace:*",
    "@app/contracts": "workspace:*",
    "@app/core": "workspace:*",
    "@app/db": "workspace:*",
    "@app/money": "workspace:*",
    "@app/notify": "workspace:*",
    "@app/strategy-core": "workspace:*",
    "@app/strategy-registry": "workspace:*",
    "@app/strategy-trailing-trade": "workspace:*",
    "drizzle-orm": "~0.45.2"
  }
}
