.idea
.vs
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Deps
node_modules

# Build outputs
dist
build
coverage
playwright-report
test-results
.app-e2e.*
.turbo
**/tsconfig.tsbuildinfo

# Python / docs build
.venv
.python-version
__pycache__/
*.py[cod]
.coverage
.pytest_cache/
.mypy_cache/
.ruff_cache/
